# Copy this file to `.env` and fill in your own values.
# NEVER commit your real .env file.

# Server
PORT=3000
# Public base URL of the deployed site (used for Stripe success/cancel redirects)
PUBLIC_BASE_URL=http://localhost:3000

# Stripe — get these from https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_... / pk_test_...) until you are ready to go live.
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
# Webhook signing secret from `stripe listen` or the Dashboard webhook config
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Currency for donations (ISO 4217)
CURRENCY=eur
